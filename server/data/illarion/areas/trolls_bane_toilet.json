{
    "enabled": true,
    "name": "Troll’s Bane Toilet",
    "description": "The toilet in Troll's Bane where logout triggers door and bucket cleanup.",
    "area": {
        "$ref": {
            "registry": "moonlight:scenarios",
            "entry": "moonlight:tb_loo",
            "path": "/areas/room"
        }
    },
    "behaviors": [
        {
            "event": "logout",
            "actions": [
                {
                    "type": "unlock_door",
                    "data": {
                        "position": {
                            "$ref": {
                                "registry": "moonlight:scenarios",
                                "entry": "moonlight:tb_loo",
                                "path": "/positions/door"
                            }
                        }
                    }
                },
                {
                    "type": "open_door",
                    "data": {
                        "position": {
                            "$ref": {
                                "registry": "moonlight:scenarios",
                                "entry": "moonlight:tb_loo",
                                "path": "/positions/door"
                            }
                        }
                    }
                },
                {
                    "type": "swap_item",
                    "data": {
                        "position": {
                            "$ref": {
                                "registry": "moonlight:scenarios",
                                "entry": "moonlight:tb_loo",
                                "path": "/positions/bucket"
                            }
                        },
                        "oldItem": "illarion:item_52",
                        "item": "illarion:item_51"
                    }
                }
            ]
        }
    ],
    "metadata": {
        "source": "server.logout",
        "scenario": "moonlight:tb_loo"
    }
}
