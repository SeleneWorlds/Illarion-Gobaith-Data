{
  "name": "monsters",
  "platform": "server",
  "icon": "skull",
  "schema": {
    "race": {
      "type": "registry",
      "registry": "illarion:races"
    },
    "hitpoints": "integer",
    "movementType": {
      "type": "enum",
      "values": [
        {
          "value": "walk",
          "label": "Walk"
        },
        {
          "value": "fly",
          "label": "Fly"
        }
      ]
    },
    "canAttack": "boolean",
    "size": "range",
    "attributes": {
      "type": "object",
      "properties": {
        "strength": "range",
        "constitution": "range",
        "dexterity": "range",
        "agility": "range",
        "intelligence": "range",
        "perception": "range",
        "essence": "range",
        "willpower": "range"
      }
    },
    "skills": {
      "type": "map",
      "keyType": {
        "type": "registry",
        "registry": "illarion:skills"
      },
      "valueType": { "type": "range", "min": 1, "max": 100 }
    },
    "items": {
      "type": "map",
      "keyType": {
        "type": "enum",
        "values": [
          { "value": "backpack", "label": "Backpack" },
          { "value": "head", "label": "Head" },
          { "value": "neck", "label": "Neck" },
          { "value": "breast", "label": "Breast" },
          { "value": "hands", "label": "Hands" },
          { "value": "left hand", "label": "Left hand" },
          { "value": "right hand", "label": "Right hand" },
          { "value": "left finger", "label": "Left finger" },
          { "value": "right finger", "label": "Right finger" },
          { "value": "legs", "label": "Legs" },
          { "value": "feet", "label": "Feet" },
          { "value": "coat", "label": "Coat" }
        ]
      },
      "valueType": {
        "type": "object",
        "properties": {
          "item": {
            "type": "registry",
            "registry": "illarion:items"
          },
          "count": { "type": "range", "min": 1, "max": 250 }
        }
      }
    },
    "drops": {
      "type": "moonlight:rolls",
      "optional": true,
      "parameters": {
        "entryTypes": {
          "nothing": { "type": "object", "properties": {} },
          "item": {
            "type": "object",
            "properties": {
              "item": { "type": "registry", "registry": "illarion:items" },
              "count": { "type": "range", "min": 1, "max": 250 },
              "quality": { "type": "range", "min": 1, "max": 9 },
              "durability": { "type": "range", "min": 0, "max": 99 },
              "wear": { "type": "integer", "min": 0, "max": 255, "optional": true },
              "data": { "type": "map", "keyType": "string", "valueType": "string", "optional": true }
            }
          }
        },
        "conditionTypes": {}
      }
    },
    "script": {
      "type": "script",
      "optional": true
    }
  }
}
