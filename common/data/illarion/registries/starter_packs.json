{
  "name": "starter_packs",
  "platform": "server",
  "icon": "backpack",
  "schema": {
    "skills": {
      "type": "map",
      "keyType": {
        "type": "registry",
        "registry": "illarion:skills"
      },
      "valueType": {
        "type": "object",
        "properties": {
          "value": "integer"
        }
      }
    },
    "items": {
      "type": "map",
      "keyType": "integer",
      "valueType": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "registry",
            "registry": "illarion:items"
          },
          "count": "integer",
          "quality": "integer",
          "durability": { "type": "integer", "min": 0, "max": 99, "optional": true }
        }
      }
    }
  }
}
